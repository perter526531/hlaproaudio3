# ───────────────────────────────────────────────────────────
# AudioCenter CMS — 环境变量模板
# 复制此文件为 .env 并按需修改：cp .env.example .env
# ───────────────────────────────────────────────────────────

# SQLite 数据库文件路径（默认放项目根的 db/ 目录）
DATABASE_URL=file:./db/custom.db

# 管理后台账号密码 —— 部署到公网前必须修改！
# 生产环境推荐用 SSH 临时设置：export ADMIN_PASSWORD=xxx，而不是写死在 .env 里
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请改成强密码

# NextAuth 密钥 —— 用 `openssl rand -base64 32` 重新生成
NEXTAUTH_SECRET=dev-secret-change-me-in-production-9f3a7c2e1b8d4a6f

# 站点对外访问地址（用于 NextAuth 回调与 cookie 域名）
# 本地开发：http://localhost:3000
# 生产环境：https://你的域名
NEXTAUTH_URL=http://localhost:3000
